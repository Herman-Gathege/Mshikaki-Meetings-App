# Mshikaki environment.
# Copy to .env and fill in. .env is never committed.
# Every variable here is validated at startup by backend/app/config.py.

# --- Application ---
APP_ENV=development
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-generate-a-real-secret
# Port published on the KBC server. The app listens on 8000 inside the container.
APP_PORT=8080
ROOT_URL=http://localhost:8080
LOG_LEVEL=info
TEAM_TIMEZONE=Africa/Nairobi

# --- Database ---
# Local development uses docker-compose.dev.yml, which publishes Postgres on
# localhost. docker-compose.yml overrides POSTGRES_HOST=db inside the compose
# network, so this value only matters when the API runs natively.
POSTGRES_USER=mshikaki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mshikaki
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional. Set only to override the DSN built from the values above.
# DATABASE_URL=postgresql+psycopg://mshikaki:change-me@localhost:5432/mshikaki

# --- Sessions and cookies ---
# Leave false on plain http (internal IP). Set true when KBC terminates TLS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=14

# --- Joining ---
# People who scan the session QR must sign up with one of these email domains.
# Comma-separated. Leave empty to allow any email.
ALLOWED_EMAIL_DOMAINS=kbc.co.ke

# --- Daily digest email (Phase 4). Disabled unless SMTP_HOST is set. ---
DIGEST_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=mshikaki@localhost
